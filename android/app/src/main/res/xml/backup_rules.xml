<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The saved servers are encrypted with a key in the
     phone's Keystore, which is not backed up. Restored onto a new phone (or
     after a reinstall) the data could not be decrypted, so it stays out of
     the backup and the servers are simply added again. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
